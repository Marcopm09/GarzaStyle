{
  "expo": {
    "name": "GarzaStyle",
    "slug": "GarzaStyle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "garzastylev13",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "GarzaStyle necesita acceso a tu cámara para tomar fotos de tus prendas.",
        "NSPhotoLibraryUsageDescription": "GarzaStyle necesita acceso a tu galería para seleccionar fotos de tus prendas.",
        "NSPhotoLibraryAddUsageDescription": "GarzaStyle necesita permiso para guardar fotos en tu galería."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.GarzaStyleV1.x3"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GarzaStyle necesita acceso a tus fotos para que puedas subir imágenes de tus prendas.",
          "cameraPermission": "GarzaStyle necesita acceso a tu cámara para que puedas tomar fotos de tus prendas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
